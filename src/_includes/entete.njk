{#- La page courante est signalée par un soulignement. Le sélecteur de langue
    est un lien vers la même page dans l'autre langue, ce qui permet à un moteur
    de recherche de la découvrir. -#}
{%- set autre = "en" if langue == "fr" else "fr" %}
<header>
  <div class="wrap nav">
    <a class="marque" href="{{ adresses['accueil'][langue] }}"><img class="symbole" src="/assets/symbole.png" alt="" aria-hidden="true"><img src="/assets/logo.png" alt="DeeeMines"></a>
    <nav class="links" id="links">
      {%- for cle in ["technologie", "antimoine", "equipe", "actualites"] %}
      <a href="{{ adresses[cle][langue] }}"{% if page_cle == cle %} class="on" aria-current="page"{% endif %}
         data-champ="communs.nav.{{ cle }}">{{ t.communs.nav[cle] }}</a>
      {%- endfor %}
    </nav>
    <div class="right">
      <span class="lang">
        {%- if langue == "fr" %}<b class="on">FR</b> / <a href="{{ adresses[page_cle]['en'] }}"><b>EN</b></a>
        {%- else %}<a href="{{ adresses[page_cle]['fr'] }}"><b>FR</b></a> / <b class="on">EN</b>{% endif %}
      </span>
      <a href="{{ adresses['accueil'][langue] }}#contact" class="btn btn-ink"
         data-champ="communs.nav.contact">{{ t.communs.nav.contact }}</a>
      <button class="burger" id="burger" aria-label="Menu">
        <svg width="22" height="14" viewBox="0 0 22 14" fill="none"><path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
    </div>
  </div>
</header>
