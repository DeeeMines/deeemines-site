<!-- ═══════════ Schéma du verrou ═══════════
     Le propos de la section est qu'un additif n'est pas posé sur le plastique
     mais pris dedans. Une photo ne peut pas le montrer ; un dessin, si.
     À gauche, un morceau de broyat. À droite, la même matière vue de près :
     les chaînes du polymère s'entrelacent et retiennent l'antimoine et les
     composés bromés. Les grains tremblent sur place, et l'un d'eux tente
     régulièrement de sortir avant d'être ramené : c'est tout le verrou.
     SVG et CSS seuls, aucune bibliothèque. Les mouvements s'arrêtent pour qui
     a demandé à son système de les réduire. -->
<div class="schema verrou">

  <div class="vr-tetes">
    <span data-champ="procede.verrou.legende">{{ t.procede.verrou.legende | safe }}</span>
    <span data-champ="procede.verrou.legende2">{{ t.procede.verrou.legende2 | safe }}</span>
  </div>

  <div class="scene" role="img" aria-label="{{ t.communs.alt.verrou }}">
    <svg viewBox="20 52 528 268" preserveAspectRatio="xMidYMid meet">
      <defs>
        <clipPath id="vrLoupe"><circle cx="404" cy="186" r="124"/></clipPath>
        <radialGradient id="vrHalo" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#52FCC3" stop-opacity=".16"/>
          <stop offset="1" stop-color="#52FCC3" stop-opacity="0"/>
        </radialGradient>
      </defs>

      <!-- ── le morceau de plastique ── -->

      <g class="eclat">
        <path d="M58 118 L142 96 L196 132 L188 212 L136 264 L64 246 L40 182 z"/>
        <path class="strie" d="M74 150 L150 132"/>
        <path class="strie" d="M70 186 L172 164"/>
        <path class="strie" d="M84 222 L164 202"/>
      </g>

      <!-- la zone que l'on regarde de près, et le cône qui y mène -->
      <circle class="viseur" cx="134" cy="178" r="30"/>
      <path class="cone" d="M158 160 L310 106"/>
      <path class="cone" d="M156 200 L310 266"/>

      <!-- ── la même matière, de près ── -->
      <circle class="loupe" cx="404" cy="186" r="124"/>
      <g clip-path="url(#vrLoupe)">
        <circle cx="404" cy="186" r="124" fill="url(#vrHalo)"/>
        <!-- les chaînes du polymère, enchevêtrées -->
        <g class="chaines">
          <path d="M272 116 C 318 92, 356 136, 404 116 S 486 138, 540 112"/>
          <path d="M268 158 C 322 182, 352 136, 406 160 S 484 132, 542 156"/>
          <path d="M268 210 C 320 186, 358 232, 408 208 S 486 230, 542 204"/>
          <path d="M272 254 C 324 280, 354 234, 406 258 S 484 232, 538 254"/>
          <path d="M318 88 C 300 148, 348 188, 326 246 S 352 300, 336 316"/>
          <path d="M472 84 C 492 146, 446 190, 470 248 S 444 302, 460 318"/>
        </g>
        <!-- les additifs, pris entre les chaînes -->
        <g class="grains">
          <circle class="gr sb g1" cx="352" cy="138" r="11"/>
          <circle class="gr br g2" cx="438" cy="136" r="9"/>
          <circle class="gr br g3" cx="318" cy="186" r="9"/>
          <circle class="gr sb g4" cx="404" cy="186" r="11"/>
          <circle class="gr br g5" cx="486" cy="184" r="9"/>
          <circle class="gr sb g6" cx="360" cy="232" r="11"/>
          <circle class="gr br g7" cx="452" cy="234" r="9"/>
        </g>
      </g>

    </svg>
  </div>

  <div class="vr-cle">
    <span><i class="sb"></i><b data-champ="procede.verrou.nom">{{ t.procede.verrou.nom | safe }}</b></span>
    <span><i class="br"></i><b data-champ="procede.verrou.nom2">{{ t.procede.verrou.nom2 | safe }}</b></span>
  </div>
</div>
