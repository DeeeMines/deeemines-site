<!-- ═══════════ Schéma du verrou ═══════════
     Le propos de la section est qu'un additif n'est pas posé sur le plastique
     mais pris dedans. Une photo ne peut pas le montrer ; un dessin, si.
     En haut, un morceau de broyat. En dessous, la même matière vue de près :
     les chaînes du polymère s'entrelacent et retiennent l'antimoine et les
     composés bromés. Les grains tremblent sur place, et celui du centre tente
     régulièrement de sortir avant d'être ramené : c'est tout le verrou.
     Format vertical, pour tenir dans la colonne à côté du texte.
     SVG et CSS seuls, aucune bibliothèque. Les mouvements s'arrêtent pour qui
     a demandé à son système de les réduire. -->
<div class="schema verrou">
  <div class="scene" role="img" aria-label="{{ t.communs.alt.verrou }}">
    <svg viewBox="0 0 400 436" preserveAspectRatio="xMidYMid meet">
      <defs>
        <clipPath id="vrLoupe"><circle cx="290" cy="300" r="86"/></clipPath>
        <radialGradient id="vrHalo" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#52FCC3" stop-opacity=".15"/>
          <stop offset="1" stop-color="#52FCC3" stop-opacity="0"/>
        </radialGradient>
      </defs>

      <!-- Deux axes d'alignement, et deux seulement : la marge de gauche porte
           l'intitulé du haut et la légende, la marge de droite porte l'intitulé
           du bas. Les deux intitulés se répondent en diagonale, comme les deux
           objets qu'ils désignent. -->

      <!-- ── les morceaux de broyat, en haut à gauche ── -->
      <text class="vlbl" x="24" y="22"
            data-champ="procede.verrou.legende">{{ t.procede.verrou.legende | safe }}</text>

      <g class="eclat menu">
        <path d="M28 68 L50 58 L68 72 L62 94 L38 98 L24 84 z"/>
        <path d="M154 60 L180 46 L204 60 L206 88 L180 102 L156 88 z"/>
        <path d="M26 150 L50 136 L74 150 L72 178 L46 190 L24 174 z"/>
      </g>

      <g class="eclat">
        <path d="M66 120 L82 86 L128 78 L148 108 L140 152 L100 166 L70 148 z"/>
        <path class="strie" d="M80 116 L128 104"/>
        <path class="strie" d="M78 138 L134 126"/>
      </g>

      <!-- la zone prélevée, et le cône qui mène à son agrandissement -->
      <circle class="viseur" cx="106" cy="122" r="26"/>
      <path class="cone" d="M93 144 L246 374"/>
      <path class="cone" d="M128 108 L363 254"/>

      <!-- la loupe, au milieu exact du trajet -->
      <g class="loupette">
        <circle cx="198" cy="211" r="13"/>
        <path class="manche" d="M188 221 L177 232"/>
        <path class="plus" d="M192 211 h12 M198 205 v12"/>
      </g>

      <!-- la légende, sur la marge de gauche, descendue là où le cercle se
           rétrécit : elle garde ainsi une vraie respiration à sa droite -->
      <g class="vcle">
        <circle class="pastille sb" cx="31" cy="330" r="7"/>
        <text class="vleg" x="48" y="335" data-champ="procede.verrou.nom">{{ t.procede.verrou.nom | safe }}</text>
        <circle class="pastille br" cx="31" cy="362" r="7"/>
        <text class="vleg" x="48" y="367" data-champ="procede.verrou.nom2">{{ t.procede.verrou.nom2 | safe }}</text>
      </g>

      <!-- ── la même matière, de près, en bas à droite ── -->
      <circle class="loupe" cx="290" cy="300" r="86"/>
      <g clip-path="url(#vrLoupe)">
        <circle cx="290" cy="300" r="86" fill="url(#vrHalo)"/>
        <g class="chaines">
          <path d="M196 256 C 222 240, 250 272, 290 256 S 352 272, 392 254"/>
          <path d="M194 286 C 224 304, 248 272, 290 288 S 350 270, 394 284"/>
          <path d="M196 316 C 226 300, 252 334, 292 314 S 354 332, 392 314"/>
          <path d="M196 346 C 228 364, 250 328, 292 346 S 352 328, 392 344"/>
          <path d="M250 208 C 236 256, 262 286, 248 326 S 268 378, 256 404"/>
          <path d="M330 208 C 344 256, 316 286, 338 326 S 320 378, 332 404"/>
        </g>
        <g class="grains">
          <circle class="gr sb g1" cx="268" cy="271" r="9"/>
          <circle class="gr br g2" cx="320" cy="269" r="7.5"/>
          <circle class="gr br g3" cx="238" cy="300" r="7.5"/>
          <circle class="gr sb g4" cx="290" cy="300" r="9"/>
          <circle class="gr br g5" cx="342" cy="299" r="7.5"/>
          <circle class="gr sb g6" cx="270" cy="331" r="9"/>
          <circle class="gr br g7" cx="320" cy="333" r="7.5"/>
        </g>
      </g>

      <text class="vlbl" x="376" y="414" text-anchor="end"
            data-champ="procede.verrou.legende2">{{ t.procede.verrou.legende2 | safe }}</text>
    </svg>
  </div>


</div>
