<style>
/* ===== Charte : couleurs relevées sur le logo DeeeMines ===== */
:root{
  --ink:#06065B; --ink-deep:#040440;
  --blue:#2B2BE8; --azure:#297EE1; --cyan:#3EBDD2; --mint:#52FCC3;
  /* variantes lisibles sur fond clair */
  --cyan-d:#1793AB; --mint-d:#0E9A72;
  --paper:#FFFAF6; --paper-2:#F5EFE9;
  --text:#06065B; --soft:#5A5E8C; --soft-dark:#B9C6E6;
  --grad:linear-gradient(90deg,#040440,#2B2BE8 34%,#297EE1 58%,#3EBDD2 78%,#52FCC3);
  --line:rgba(6,6,91,.12); --line-d:rgba(255,255,255,.15);
  --disp:"Inter Tight",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  --sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  --pad:clamp(22px,5vw,80px); --maxw:1200px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--text);font-family:var(--sans);
  font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
p{margin:0}
ul{margin:0;padding:0;list-style:none}
h1,h2,h3,h4{margin:0;font-family:var(--disp);font-weight:500;letter-spacing:-.035em;line-height:1}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--pad)}
section{padding:clamp(44px,4.6vw,68px) 0}
.dark{background:var(--ink-deep);color:#fff}
.dark+.dark{padding-top:clamp(48px,5.5vw,80px)}
.dark p{color:var(--soft-dark)}
.tint{background:var(--paper-2)}

h1{font-size:clamp(38px,6.6vw,88px);line-height:.98}
h2{font-size:clamp(30px,4.4vw,52px);line-height:1.06}
h3{font-size:clamp(20px,2vw,25px);letter-spacing:-.028em;line-height:1.14}

.eyebrow,.rowtxt .tag,.na .when,.na .cat,.bul .nom{font-size:12px;font-weight:500;
  letter-spacing:.16em;text-transform:uppercase;line-height:1.35}
.eyebrow{color:var(--soft);margin-bottom:26px}
.dark .eyebrow{color:var(--mint)}
.lead{font-size:clamp(16.5px,1.45vw,19px);line-height:1.62;color:var(--soft);max-width:62ch}
.lead p+p{margin-top:15px}
.dark .lead{color:#C6D0EE}

.btn{display:inline-flex;align-items:center;gap:9px;font-size:15px;font-weight:500;
  padding:15px 28px;border-radius:100px;border:1px solid transparent;transition:.22s;cursor:pointer}
.btn-mint{background:var(--mint);color:var(--ink-deep)}
.btn-mint:hover{background:#fff}
.btn-line{border-color:rgba(255,255,255,.42);color:#fff}
.btn-line:hover{border-color:#fff;background:rgba(255,255,255,.12)}
.btn-ink{background:var(--ink);color:#fff}
.btn-ink:hover{background:var(--blue)}
.btn .a{transition:transform .22s}
.btn:hover .a{transform:translateX(3px)}
.grad-rule{height:3px;background:var(--grad);border:0;margin:0}

/* ===== En-tête ===== */
header{position:sticky;top:0;z-index:50;background:rgba(255,250,246,.92);
  backdrop-filter:saturate(160%) blur(14px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:76px;gap:20px}
.nav img{height:31px;width:auto}
.links{display:flex;gap:32px}
.links a{font-size:14.5px;color:var(--soft);transition:.2s;position:relative}
.links a:hover,.links a.on{color:var(--text)}
.links a:focus{outline:none}
.links a:focus-visible{outline:2px solid var(--azure);outline-offset:4px;border-radius:2px}
.links a.on::after{content:"";position:absolute;left:0;right:0;bottom:-8px;height:2px;background:var(--grad)}
.right{display:flex;align-items:center;gap:18px}
.lang{font-size:12.5px;color:var(--soft);letter-spacing:.06em;white-space:nowrap}
.lang b{font-weight:500;cursor:pointer;color:var(--soft);transition:.18s}
.lang b:hover{color:var(--text)}
.lang b.on{color:var(--text)}
.burger{display:none;background:none;border:0;color:var(--text);padding:8px;cursor:pointer}
@media(max-width:960px){
  .links{display:none;position:absolute;top:76px;left:0;right:0;background:var(--paper);
    flex-direction:column;gap:0;padding:4px var(--pad) 18px;border-bottom:1px solid var(--line)}
  .links.open{display:flex}
  .links a{padding:14px 0;border-bottom:1px solid var(--line);font-size:17px}
  .links a.on::after{display:none}
  .burger{display:block}
  .right .btn{display:none}
}

/* ===== 1. HERO vidéo ===== */
.hero{position:relative;min-height:min(84vh,740px);display:flex;align-items:flex-end;
  color:#fff;overflow:hidden;
  background:radial-gradient(900px 560px at 82% 4%,rgba(82,252,195,.16),transparent 62%),
             radial-gradient(760px 520px at 0% 100%,rgba(43,43,232,.38),transparent 66%),
             var(--ink-deep);
  padding:clamp(90px,13vw,150px) 0 clamp(64px,8vw,100px)}
.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.hero .veil{position:absolute;inset:0;z-index:1;
  background:linear-gradient(180deg,rgba(4,4,64,.48) 0%,rgba(4,4,64,.24) 45%,rgba(4,4,64,.70) 100%),
             linear-gradient(90deg,rgba(4,4,64,.54) 0%,rgba(4,4,64,.05) 62%,rgba(4,4,64,.22) 100%)}
.hero .wrap{position:relative;z-index:2;width:100%}
.hero h1{max-width:17ch;text-shadow:0 2px 30px rgba(4,4,64,.85),0 1px 3px rgba(4,4,64,.4)}
.hero h1 span{color:var(--mint)}
.hero .lead{max-width:58ch;color:#EAEFFB;font-size:clamp(16.5px,1.5vw,19.5px);margin-top:28px;
  text-shadow:0 1px 18px rgba(4,4,64,.9),0 1px 2px rgba(4,4,64,.5)}
.acts{margin-top:38px;display:flex;flex-wrap:wrap;gap:12px}

/* ===== 2. SOUVERAINETÉ · chiffres en bandeau plein ===== */
.stmt{display:grid;grid-template-columns:1.06fr 1fr;gap:clamp(26px,3.4vw,48px);align-items:center}
.stmt .lead,.stmt p.lead{max-width:none}
@media(max-width:880px){.stmt{grid-template-columns:1fr}}
.stmt h2{max-width:22ch}
.figs{margin-top:clamp(28px,3.2vw,44px);border-top:1px solid var(--line);
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
.fig{padding:38px 44px 4px;border-right:1px solid var(--line);display:flex;flex-direction:column}
.fig:first-child{padding-left:0}
.fig:last-child{border-right:0}
.fig .n{font-family:var(--disp);font-weight:500;letter-spacing:-.05em;line-height:.92;
  font-size:clamp(60px,8vw,112px);color:var(--c);min-height:.92em;display:flex;align-items:flex-end}
.fig .k{margin-top:16px;font-family:var(--disp);font-size:clamp(18px,1.75vw,21px);
  font-weight:500;letter-spacing:-.03em;line-height:1.25;min-height:2.5em;
  display:flex;align-items:flex-start}
.fig p{margin-top:14px;font-size:15.2px;line-height:1.6;color:var(--soft);max-width:36ch;min-height:4.8em}
/* Quatre colonnes : chacune perd un quart de sa largeur. Les chiffres, les
   marges intérieures et les libellés se resserrent en conséquence. */
.figs-4{grid-template-columns:repeat(4,minmax(0,1fr))}
.figs-4 .fig{padding:34px 26px 4px;text-align:center;align-items:center}
.figs-4 .fig:first-child{padding-left:26px}
.figs-4 .fig .n{justify-content:center}
.figs-4 .fig .k{justify-content:center;text-align:center}
.figs-4 .fig p{margin-left:auto;margin-right:auto}
.figs-4 .fig .n{font-size:clamp(48px,5.4vw,78px)}
.figs-4 .fig .k{font-size:clamp(16px,1.5vw,18.5px);min-height:2.5em}
.figs-4 .fig p{font-size:14.4px;min-height:4.8em}
@media(max-width:1080px){
  .figs-4{grid-template-columns:repeat(2,minmax(0,1fr))}
  .figs-4 .fig:nth-child(2n){border-right:0}
  .figs-4 .fig:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .figs-4 .fig:nth-child(n+3){padding-top:34px}
}
@media(max-width:620px){
  .figs-4{grid-template-columns:1fr}
  .figs-4 .fig{border-right:0;border-bottom:1px solid var(--line);padding:30px 0 26px}
  .figs-4 .fig .k,.figs-4 .fig p{min-height:0}
}

@media(max-width:880px){
  .figs{grid-template-columns:1fr}
  .fig{border-right:0;border-bottom:1px solid var(--line);padding:30px 0 26px}
}

/* ===== 3. NOTRE SOLUTION · lignes alternées ===== */
.row{display:grid;grid-template-columns:.62fr 1.38fr;gap:clamp(30px,5vw,74px);align-items:center;
  padding:clamp(32px,3.4vw,46px) 0;border-top:1px solid var(--line)}
.row:first-of-type,.stmt+.row{border-top:0;padding-top:clamp(30px,3.4vw,46px)}
.row.flip{grid-template-columns:1.38fr .62fr}
.row.flip .panel{order:2}
.panel{aspect-ratio:5/4;border-radius:10px;position:relative;overflow:hidden;
  background:linear-gradient(150deg,#06065B,#040440 62%);
  display:flex;align-items:center;justify-content:center}
.panel::after{content:"";position:absolute;inset:0;
  background:radial-gradient(70% 70% at 30% 22%,color-mix(in srgb,var(--c) 26%,transparent),transparent 68%)}
.el{position:relative;z-index:2;text-align:center;color:#fff;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  height:clamp(104px,12vw,140px)}
.el .z{font-size:11px;letter-spacing:.16em;color:var(--c);height:18px;line-height:18px}
.el .s{font-family:var(--disp);font-weight:400;font-size:clamp(50px,6.2vw,84px);
  line-height:1;letter-spacing:-.05em;flex:1;display:flex;align-items:center;justify-content:center}
.el .m{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--soft-dark);
  height:18px;line-height:18px}
.rowtxt .tag{color:var(--ct,var(--c));margin-bottom:14px}
.rowtxt h3{font-size:clamp(25px,3vw,36px);margin-bottom:14px}
.rowtxt p{font-size:16.4px;line-height:1.62;color:var(--soft)}
.rowtxt .who{margin-top:20px;font-size:14.6px;color:var(--soft)}
.rowtxt .who b{color:var(--text);font-weight:500}
@media(max-width:880px){
  .row,.row.flip{grid-template-columns:1fr;gap:26px}
  .row.flip .panel{order:0}
  .panel{aspect-ratio:16/9}
}

/* ===== 4. NOTRE TECHNOLOGIE · chaîne de procédé ===== */
.flow{margin-top:clamp(68px,7.4vw,102px);position:relative;--g:clamp(20px,3vw,40px)}
.flow .track{position:absolute;left:calc(12.5% - var(--g) * .375);width:calc(75% + var(--g) * .75);top:-75px;height:200px;opacity:.9}
.flow .track svg{width:100%;height:100%;display:block}
.flow .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--g);position:relative}
.st{text-align:center}
.st p{margin-left:auto;margin-right:auto;max-width:30ch}
.st .dot{width:20px;height:20px;border-radius:50%;background:var(--ink-deep);margin:0 auto;
  border:2px solid var(--c);display:flex;align-items:center;justify-content:center;position:relative;z-index:2}
.st .dot i{width:8px;height:8px;border-radius:50%;background:var(--c);display:block}
.st .num{margin-top:96px;font-size:12px;letter-spacing:.16em;color:var(--soft-dark)}
.st h3{margin:8px 0 10px;color:#fff}
.st p{font-size:14.6px;line-height:1.58}
@media(max-width:880px){
  .flow .track{left:9px;width:2px;top:6px;bottom:6px;height:auto;
    background:var(--grad);opacity:.5}
  .flow .track svg{display:none}
  .chips{margin-top:40px}
  .flow .steps{grid-template-columns:1fr;gap:30px}
  .st{padding-left:38px;position:relative;text-align:left}
  .st p{margin-left:0;max-width:none}
  .st .dot{position:absolute;left:0;top:2px;margin:0}
  .st .num{margin-top:0}
}
.chips{margin-top:clamp(28px,3.2vw,46px);display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
@media(max-width:880px){.chips{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.chips{grid-template-columns:1fr}}
.chip{border:1px solid var(--line-d);border-radius:14px;padding:22px 20px 20px;text-align:center;
  background:rgba(255,255,255,.03);display:flex;flex-direction:column}
.chip b{display:block;font-family:var(--disp);font-weight:500;letter-spacing:-.03em;
  font-size:clamp(21px,2.2vw,27px);line-height:1.14;color:var(--mint);margin-bottom:10px;
  min-height:1.14em;display:flex;align-items:center;justify-content:center;text-align:center}
.chip span{display:block;font-size:13.6px;line-height:1.45;color:var(--soft-dark)}

.dist{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,3.4vw,54px);margin-top:22px}
.di{display:grid;grid-template-columns:132px 1fr;gap:24px;align-items:center}
.di img{max-height:40px;max-width:100%;width:auto;height:auto;object-fit:contain;justify-self:center}
.di h3{font-size:18px;margin-bottom:5px}
.di p{font-size:14.6px;color:var(--soft);line-height:1.5}
@media(max-width:820px){.dist{grid-template-columns:1fr;gap:22px}}

/* ===== 5. Bandeau partenaires ===== */
.band{padding:clamp(42px,4.6vw,66px) 0;background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.logos{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;
  gap:clamp(18px,2vw,30px) clamp(14px,1.6vw,26px);margin-top:34px}
.logos div{display:flex;align-items:center;justify-content:center;height:56px;flex:0 0 148px}
.logos img{max-height:44px;max-width:150px;width:auto;opacity:.82;transition:.2s}
.logos img:hover{opacity:1}
.logos .todo{font-size:12px;color:var(--soft);opacity:.55;font-style:italic;text-align:center;line-height:1.3}
@media(max-width:900px){.logos{grid-template-columns:repeat(4,1fr)}}
@media(max-width:600px){.logos{grid-template-columns:repeat(3,1fr);gap:20px}.logos div{height:44px}}

/* ===== 6. Feuille de route · échelle de traitement ===== */

.sc .per{font-size:12px;letter-spacing:.17em;text-transform:uppercase;color:var(--cd,var(--c));padding-top:14px;font-weight:500}
.sc .q{font-family:var(--disp);font-weight:500;letter-spacing:-.045em;line-height:1;color:var(--text);
  font-size:clamp(32px,4.4vw,54px)}
.sc .bar{margin-top:20px;height:7px;border-radius:4px;background:rgba(6,6,91,.07);overflow:hidden}
.sc .bar i{display:block;height:100%;border-radius:4px;background:var(--cd,var(--c));width:var(--w)}
.sc p{margin-top:20px;font-size:15.4px;line-height:1.62;color:var(--soft)}
@media(max-width:820px){.sc{grid-template-columns:1fr;gap:10px}.sc .per{padding-top:0}}

/* ===== 7. Contact ===== */
.cgrid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,6vw,84px);align-items:end}
.f{margin-bottom:18px}
.f label{display:block;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--soft-dark);margin-bottom:8px}
.f input,.f select,.f textarea{width:100%;background:rgba(255,255,255,.06);border:1px solid var(--line-d);
  color:#fff;padding:14px 15px;font-family:var(--sans);font-size:15px;border-radius:6px;outline:none;transition:.2s}
.f textarea{min-height:114px;resize:vertical}
.f input:focus,.f select:focus,.f textarea:focus{border-color:var(--mint);background:rgba(255,255,255,.1)}
.f select option{background:var(--ink)}
.co{margin-top:34px}
.co li{padding:12px 0;border-top:1px solid var(--line-d);display:flex;gap:20px;align-items:baseline}
.co .k{font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--mint);
  flex:none;width:78px;padding-top:2px}
/* L'adresse électronique est longue. En dernier recours elle se coupe plutôt
   que de pousser la page vers la droite. */
.co .v{font-size:16.5px;color:#fff;overflow-wrap:anywhere}
@media(max-width:880px){.cgrid{grid-template-columns:1fr;align-items:start}}
/* Sur téléphone, le libellé passe au-dessus : la valeur dispose alors de toute
   la largeur et l'adresse tient sur une seule ligne. */
@media(max-width:560px){
  .co li{display:block}
  .co .k{width:auto;padding-top:0;margin-bottom:5px}
}

.sent{border:1px solid var(--line-d);border-radius:10px;padding:38px 30px;text-align:center;
  background:rgba(82,252,195,.06)}
.sent .tick{width:48px;height:48px;border-radius:50%;background:var(--mint);color:var(--ink-deep);
  display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 20px}
.sent h3{color:#fff;margin-bottom:10px}
.sent p{color:var(--soft-dark);font-size:15.4px}
.cerr{margin-top:16px;font-size:14.6px;color:#FFB4A8}
.sent .alt{display:inline-block;margin-top:18px;font-size:14px;color:var(--mint);
  border-bottom:1px solid rgba(82,252,195,.4);padding-bottom:2px}

/* ===== Apparitions au défilement =====
   Les états initiaux ne s'appliquent que si le script les active (classe .anim),
   pour que la page reste lisible sans JavaScript. */
html.anim .reveal{opacity:0;transform:translateY(16px);
  transition:opacity .75s cubic-bezier(.22,.61,.36,1),transform .75s cubic-bezier(.22,.61,.36,1);
  transition-delay:calc(var(--i,0) * 70ms);will-change:opacity,transform}
html.anim .reveal.in{opacity:1;transform:none}

/* les barres de la feuille de route se remplissent */
html.anim .sc .bar i{width:0;transition:width 1.15s cubic-bezier(.22,.61,.36,1) .2s}
html.anim .sc.in .bar i{width:var(--w)}

/* la sinusoïde se dévoile de gauche à droite */
html.anim .flow .track{clip-path:inset(0 100% 0 0);
  transition:clip-path 1.5s cubic-bezier(.33,.1,.2,1) .15s}
html.anim .flow.in .track{clip-path:inset(0 0 0 0)}

@media(prefers-reduced-motion:reduce){
  html.anim .reveal,html.anim .reveal.in{opacity:1;transform:none;transition:none}
  html.anim .sc .bar i{width:var(--w);transition:none}
  html.anim .flow .track{clip-path:none;transition:none}
}

/* ===== Pages internes ===== */
.page{display:none}
.page.active{display:block;animation:fade .32s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.phead{background:var(--ink-deep);color:#fff;position:relative;overflow:hidden;
  padding:clamp(74px,10vw,128px) 0 clamp(54px,7vw,88px)}
.phead::before{content:"";position:absolute;inset:0;
  background:radial-gradient(820px 460px at 86% 0%,rgba(82,252,195,.14),transparent 64%),
             radial-gradient(700px 460px at 0% 100%,rgba(43,43,232,.3),transparent 66%)}
.phead .wrap{position:relative}
.phead h1{max-width:16ch}
.phead .lead{color:#C6D0EE;margin-top:26px;max-width:68ch}
.phead-art h1{font-size:clamp(30px,4.4vw,58px);max-width:22ch}
.retour{display:inline-block;font-size:13px;letter-spacing:.06em;color:var(--soft-dark);
  margin-bottom:26px}
.retour:hover span{border-bottom:1px solid rgba(255,255,255,.35)}
.art{max-width:74ch}
.art-img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;display:block;
  margin-bottom:clamp(28px,3.4vw,44px);box-shadow:0 0 0 1px var(--line)}
.art-corps{font-size:17px;line-height:1.72;color:var(--soft)}
.art-corps .chapo{font-size:19.5px;line-height:1.6;color:var(--text);margin-bottom:26px}
.art-corps p{margin-bottom:20px}
.art-corps h3{font-family:var(--disp);font-size:clamp(20px,2.2vw,25px);color:var(--text);
  margin:34px 0 14px;letter-spacing:-.02em}
.art-corps ul{margin:0 0 20px 20px;list-style:disc}
.art-corps li{margin-bottom:8px}
.art-corps a{color:var(--azure);border-bottom:1px solid rgba(41,126,225,.35)}
.art-photos{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:clamp(30px,3.6vw,46px)}
.art-photos figure{margin:0}
.art-photos img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;display:block;
  box-shadow:0 0 0 1px var(--line)}
.art-photos figcaption{margin-top:9px;font-size:13.2px;line-height:1.45;color:var(--soft)}
@media(max-width:700px){.art-photos{grid-template-columns:1fr}}
.people{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,3vw,44px);margin-top:30px}
.mem{display:flex;gap:24px;align-items:flex-start}
.mem .av{width:104px;height:104px;border-radius:50%;flex:none;object-fit:cover;
  box-shadow:0 0 0 1px var(--line)}
.mem h3{font-size:22px;margin-bottom:4px}
.mem .r{font-size:14.5px;color:var(--azure);font-weight:500;margin-bottom:9px}
.mem p{font-size:15px;color:var(--soft);line-height:1.55}
.mem .aff{margin-top:16px;display:flex;align-items:center;gap:10px}
.mem .aff{gap:16px;flex-wrap:wrap}
.mem .aff img{height:44px;width:auto;opacity:.85}
.mem .aff img[src*="chimie-paristech"]{height:54px}
.pc .aff img[src*="chimie-paristech"]{height:46px}
@media(max-width:520px){
  .mem .aff img{height:36px}
  .mem .aff img[src*="chimie-paristech"]{height:44px}
  .pc .aff img{height:32px}
  .pc .aff img[src*="chimie-paristech"]{height:38px}
}
.pc .ph{width:78px;height:78px;border-radius:50%;object-fit:cover;margin-bottom:18px;
  box-shadow:0 0 0 1px var(--line)}
.pc{border-top:2px solid var(--c);padding-top:22px}
.pc .aff{margin-top:14px;display:flex;align-items:center;gap:8px}
.pc .aff{gap:14px;flex-wrap:wrap}
.pc .aff img{height:38px;width:auto;opacity:.8}
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(22px,3vw,40px);margin-top:30px}
.news{margin-top:0}
.na{display:grid;grid-template-columns:170px 1fr;gap:clamp(24px,4vw,54px);
  padding:clamp(24px,2.6vw,34px) 0;border-top:1px solid var(--line);align-items:start}
.na:first-child{border-top:0;padding-top:0}
.na .when{color:var(--soft);padding-top:7px}
.na .cat{color:var(--ct,var(--azure));margin-bottom:9px}
.na h3{font-size:clamp(21px,2.2vw,27px);margin-bottom:12px;max-width:34ch}
.na p{font-size:15.6px;line-height:1.62;color:var(--soft);max-width:76ch}
.nc.illustree{display:grid;grid-template-columns:1fr 290px;gap:clamp(24px,3vw,44px);align-items:start}
.nimg{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;display:block;
  box-shadow:0 0 0 1px var(--line)}
@media(max-width:880px){.nc.illustree{grid-template-columns:1fr}}
.na .nlien{display:inline-block;margin-top:15px;font-size:14.6px;color:var(--azure);
  border-bottom:1px solid rgba(41,126,225,.35);padding-bottom:2px}
.na .nlien .a{transition:transform .2s}
.na .nlien:hover .a{display:inline-block;transform:translateX(3px)}
@media(max-width:820px){.na{grid-template-columns:1fr;gap:10px}.na .when{padding-top:0}}
.pc{border-top:2px solid var(--c);padding-top:20px}
.pc h3{font-size:20px;margin-bottom:6px}
.pc p{font-size:14.8px;color:var(--soft);line-height:1.55}
.dark .pc p{color:var(--soft-dark)}
.dark .pc h3{color:#fff}
@media(max-width:820px){.people{grid-template-columns:1fr;gap:32px}.cards3{grid-template-columns:1fr;gap:26px}}

/* ===== Pages L'antimoine et mentions ===== */
.concl{display:grid;grid-template-columns:1fr auto;gap:clamp(28px,4vw,56px);align-items:center}
@media(max-width:820px){.concl{grid-template-columns:1fr;justify-items:start}}
.bulles{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(20px,2.6vw,38px);
  margin-top:clamp(28px,3.2vw,46px)}
.bul{text-align:center}
.bul .rond{width:100%;max-width:124px;aspect-ratio:1;margin:0 auto 16px;border-radius:50%;
  display:grid;place-items:center;background:var(--paper-2);border:1px solid var(--line);color:var(--c)}
.bul svg{width:52%;height:52%}
.bul .nom{color:var(--text)}
.bul .det{font-size:13.4px;line-height:1.5;color:var(--soft);margin-top:8px}
@media(max-width:880px){.bulles{grid-template-columns:repeat(2,1fr)}}
.uses{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,4vw,52px);margin-top:clamp(28px,3.2vw,46px)}
.use{border-top:2px solid var(--c);padding-top:22px}
.use .pct{font-family:var(--disp);font-weight:500;letter-spacing:-.045em;line-height:1;
  font-size:clamp(46px,5.6vw,72px);color:var(--c);margin-bottom:14px}
.use h3{font-size:19px;margin-bottom:10px}
.use p{font-size:15px;color:var(--soft);line-height:1.6}
.dark .use p{color:var(--soft-dark)}
@media(max-width:820px){.uses{grid-template-columns:1fr;gap:32px}}

.steps-n{margin-top:clamp(26px,3vw,42px)}
.sn{display:grid;grid-template-columns:74px 1fr;gap:24px;padding:28px 0;border-top:1px solid var(--line);align-items:baseline}
.sn:last-child{border-bottom:1px solid var(--line)}
.sn .i{font-family:var(--disp);font-size:clamp(28px,3vw,38px);font-weight:500;color:var(--azure);letter-spacing:-.03em;line-height:1}
.sn h3{font-size:21px;margin-bottom:8px}
.sn p{font-size:15.4px;color:var(--soft);line-height:1.6}

.legal{max-width:74ch}
.legal h3{font-size:21px;margin:38px 0 12px}
.legal h3:first-child{margin-top:0}
.legal p,.legal li{font-size:15.6px;line-height:1.7;color:var(--soft)}
.legal p+p{margin-top:12px}
.legal ul{margin:12px 0 0;padding-left:20px;list-style:disc}
.legal li{margin-bottom:6px}
.legal b{color:var(--text);font-weight:500}
.legal .todo{background:rgba(82,252,195,.12);border-left:2px solid var(--mint);
  padding:14px 18px;margin:16px 0;font-size:14.6px;color:var(--soft)}

/* ===== Pied de page ===== */
footer{background:var(--paper-2);border-top:1px solid var(--line);padding:50px 0 28px}
.fg{display:flex;justify-content:space-between;gap:34px;flex-wrap:wrap;align-items:flex-start}
.fg img{height:23px;width:auto}
.fl{display:flex;gap:30px;flex-wrap:wrap}
.fl a{font-size:14.5px;color:var(--soft)}
.fl a:hover{color:var(--text)}
.fb a:hover{color:var(--text);text-decoration:underline}
.fb{margin-top:38px;padding-top:20px;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--soft)}

/* ===== Page « Le procédé » ===== */
.video{margin-top:clamp(22px,2.6vw,34px);display:grid;grid-template-columns:1.5fr 1fr;
  gap:clamp(24px,3.4vw,48px);align-items:center}
@media(max-width:880px){.video{grid-template-columns:1fr}}
.video .cadre{position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;
  background:var(--ink-deep);border:1px solid var(--line)}
.video .cadre iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
/* Le lecteur extérieur n'est chargé qu'au clic : la page reste légère et
   aucune requête ne part vers la plateforme tant que rien n'est demandé. */
.video .cadre.apercu{cursor:pointer}
.video .cadre.apercu img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.video .cadre.apercu::after{content:"";position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(4,4,64,.18),rgba(4,4,64,.42));transition:.25s}
.video .cadre.apercu:hover::after{background:linear-gradient(180deg,rgba(4,4,64,.06),rgba(4,4,64,.3))}
.video .jouer{position:absolute;inset:0;margin:auto;width:74px;height:74px;z-index:2;
  border:0;background:none;color:#fff;cursor:pointer;padding:0;transition:transform .25s}
.video .cadre.apercu:hover .jouer{transform:scale(1.08)}
.video .jouer svg{width:100%;height:100%;filter:drop-shadow(0 2px 14px rgba(4,4,64,.6))}
/* Tant que le lien n'est pas renseigné, un visuel d'attente occupe la place
   exacte de la vidéo : la mise en page ne bougera pas le jour de l'ajout. */
.video .cadre.vide{display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:16px;color:rgba(255,255,255,.5);text-align:center;padding:24px}
.video .cadre.vide p{font-size:14.6px;line-height:1.5;max-width:34ch;color:rgba(255,255,255,.55)}
.video .vlegende{max-width:none}

/* --- Page « Le procédé » : colonne de titre plus étroite, texte justifié ---
   Le titre tient alors sur trois lignes et le paragraphe gagne en largeur.
   La césure automatique évite les trous que la justification creuse. */
#page-procede .stmt{grid-template-columns:.82fr 1.18fr;align-items:center}
#page-procede .stmt h2{max-width:15ch}
#page-procede .stmt-large{grid-template-columns:1.12fr .88fr}
#page-procede .stmt-large h2{max-width:24ch}
@media(max-width:880px){ #page-procede .stmt-large{grid-template-columns:1fr}}
#page-procede .stmt .lead{max-width:none}
#page-procede .stmt .lead p{hyphens:auto;-webkit-hyphens:auto;text-wrap:pretty}
#page-procede .stmt .lead p+p{margin-top:15px}
#page-procede .mesures p{hyphens:auto;-webkit-hyphens:auto;text-wrap:pretty}
@media(max-width:880px){
  #page-procede .stmt{grid-template-columns:1fr}
  #page-procede .stmt h2{max-width:none}
}
#page-procede .lead b,#page-procede .mesures b,#page-procede .preuves b{font-weight:600;color:inherit}
#page-procede .stmt .lead b{color:var(--text)}
#page-procede .dark .stmt .lead b,#page-procede .preuves b{color:#fff}

/* Bloc des preuves : moins d'air vertical, davantage de largeur utile */

/* Bouton d'accès à la page, centré, avec sa fiole */
.vers-procede{margin-top:clamp(34px,4vw,52px);display:flex;justify-content:center}
.btn-fiole{gap:12px}
.fiole{width:22px;height:26px;flex:none;overflow:visible}
.fiole .jus{transform-origin:13px 24px;animation:remuer 3.4s ease-in-out infinite}
.fiole .b1,.fiole .b2,.fiole .b3{opacity:0}
.btn-fiole:hover .b1{animation:bulle 1.5s ease-in infinite}
.btn-fiole:hover .b2{animation:bulle 1.5s ease-in .45s infinite}
.btn-fiole:hover .b3{animation:bulle 1.5s ease-in .9s infinite}
@keyframes remuer{0%,100%{transform:rotate(0deg)}35%{transform:rotate(-2.4deg)}70%{transform:rotate(2.4deg)}}
@keyframes bulle{0%{opacity:0;transform:translateY(3px) scale(.6)}
  30%{opacity:.9}100%{opacity:0;transform:translateY(-11px) scale(1)}}
@media(prefers-reduced-motion:reduce){
  .fiole .jus{animation:none}
  .btn-fiole:hover .b1,.btn-fiole:hover .b2,.btn-fiole:hover .b3{animation:none}
}

/* La chaîne d'étapes reprise sur la page du procédé : mêmes proportions que
   sur l'accueil, avec des textes plus longs, donc un peu plus de place. */
.flow-page{margin-top:clamp(44px,5vw,66px)}
.flow-page .st p{max-width:34ch;font-size:14.4px}
#page-procede .flow .st h3{color:var(--text)}
#page-procede .flow .st .num{color:var(--soft)}
#page-procede .flow .st .dot{background:var(--paper)}
@media(max-width:880px){ #page-procede .flow-page .track{background:var(--grad);opacity:.45}}

/* Ce qui sort du procédé : trois colonnes sobres, sans les grandes cartes
   de l'accueil, pour rappeler sans répéter. */
.sorties{margin-top:clamp(30px,3.6vw,46px);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:clamp(22px,3vw,44px)}
@media(max-width:840px){.sorties{grid-template-columns:1fr;gap:28px}}
.sorties .sym{font-family:var(--disp);font-size:34px;font-weight:500;letter-spacing:-.03em;
  color:var(--mint-d);line-height:1;margin-bottom:12px;height:1em}
/* L'indice de « Cn » ne doit pas rallonger la ligne, sinon le titre de la
   troisième colonne descend et les trois ne s'alignent plus. */
.sorties .sym sub{font-size:.6em;line-height:0;vertical-align:baseline;position:relative;top:.18em}
.sorties h3{margin-bottom:9px}
.sorties p{font-size:15.2px;line-height:1.6;color:var(--soft);
  hyphens:auto;-webkit-hyphens:auto;text-wrap:pretty}

/* ═════════ Schéma animé du procédé ═════════
   Deux colonnes : la scène à gauche, la sinusoïde et les quatre étapes à
   droite. Entièrement en SVG et en CSS, sans bibliothèque ni fichier chargé. */
.schema{margin-top:clamp(30px,3.6vw,48px);background:var(--ink-deep);border-radius:18px;overflow:hidden;
  padding:clamp(20px,2.4vw,34px) clamp(16px,2.2vw,32px);
  display:grid;grid-template-columns:1.16fr 1fr;gap:clamp(16px,2.2vw,34px);align-items:stretch}
.schema svg{display:block}
/* la scène est centrée verticalement : même respiration au-dessus des
   morceaux qui tombent et sous la phrase des solvants */
.scene{display:flex;align-items:center}
.scene svg{width:100%;height:auto}
.schema .lbl{font-family:var(--sans);font-size:13px;letter-spacing:.13em;
  text-transform:uppercase;fill:#8FA0CE}
.schema .sous{font-family:var(--sans);font-size:13.5px;fill:#6E7DB6}
.schema .lbl.mint{fill:var(--mint);text-anchor:middle;letter-spacing:.1em}
.schema .lbl.fort{fill:#fff}

/* ── les gros morceaux tombent vers le broyeur ── */
.gros .gr{fill:#5F6CA0}
.g1{animation:sg-gros 4.5s ease-in infinite}
.g2{animation:sg-gros 4.5s ease-in 1.5s infinite}
.g3{animation:sg-gros 4.5s ease-in 3s infinite}
@keyframes sg-gros{
  0%  {transform:translate(136px,-52px) rotate(-16deg);opacity:0}
  16% {opacity:1}
  66% {transform:translate(146px,30px) rotate(12deg);opacity:1}
  84%,100%{transform:translate(152px,52px) rotate(22deg);opacity:0}
}
.carter{fill:none;stroke:#5A6BA8;stroke-width:2;stroke-linejoin:round}
.rouleau circle{fill:none;stroke:#7C88B8;stroke-width:2}
.rouleau .dents path{stroke:#7C88B8;stroke-width:2.4;stroke-linecap:round}
.rouleau{transform-box:fill-box;transform-origin:center}
.r1{animation:sg-tourne 3.2s linear infinite}
.r2{animation:sg-tourne 3.2s linear infinite reverse}
.r2 .dents{transform:rotate(22.5deg);transform-box:fill-box;transform-origin:center}
@keyframes sg-tourne{to{transform:rotate(360deg)}}

/* ── les copeaux tombent jusqu'à la surface du bain, où ils disparaissent ── */
.copeaux .cp{fill:#7C88B8}
.c1{animation:sg-copeau 3.8s ease-in infinite}
.c2{animation:sg-copeau 3.8s ease-in .95s infinite}
.c3{animation:sg-copeau 3.8s ease-in 1.9s infinite}
.c4{animation:sg-copeau 3.8s ease-in 2.85s infinite}
@keyframes sg-copeau{
  0%  {transform:translate(152px,150px) rotate(0deg);opacity:0}
  12% {opacity:1}
  82% {transform:translate(162px,282px) rotate(74deg);opacity:1}
  96%,100%{transform:translate(164px,302px) rotate(88deg);opacity:0}
}

/* ── le réacteur : deux phases, de la matière en suspension, un agitateur ── */
.schema .cuve{fill:none;stroke:#6E7DB6;stroke-width:2.4}
.moteur{fill:#141466;stroke:#6E7DB6;stroke-width:2}
/* Le tracé des phases porte une houle régulière, plus large que la cuve.
   On le fait défiler d'exactement une longueur d'onde : la boucle est
   invisible et le liquide paraît réellement onduler. */
.schema .phase.org{fill:url(#sgOrg);animation:sg-houle-o 6.5s linear infinite}
.schema .phase.aq{fill:url(#sgAq);animation:sg-houle-a 9s linear infinite}
@keyframes sg-houle-o{from{transform:translate(0,0)}to{transform:translate(-110px,0)}}
@keyframes sg-houle-a{from{transform:translate(0,0)}to{transform:translate(140px,0)}}
/* les grains dérivent lentement, chacun à son rythme, ce qui donne au bain
   l'aspect d'un milieu vivant plutôt que d'un aplat de couleur */
.grains circle{animation-name:sg-derive;animation-timing-function:ease-in-out;
  animation-iteration-count:infinite}
.grains.org circle{fill:#8E9BD0;opacity:.55}
.grains.aq circle{fill:#52FCC3;opacity:.5}
@keyframes sg-derive{
  0%,100%{transform:translate(0,0)}
  25%{transform:translate(9px,-7px)}
  50%{transform:translate(-7px,6px)}
  75%{transform:translate(6px,5px)}
}
.arbre{stroke:#9AA6D2;stroke-width:3;stroke-linecap:round}
/* La pale tourne autour de l'arbre : on l'aplatit puis on la rouvre, ce qui
   donne l'illusion d'une rotation vue de face. */
.pale{fill:#9AA6D2;transform-box:fill-box;transform-origin:center;
  animation:sg-pale 1.7s ease-in-out infinite}
@keyframes sg-pale{0%,100%{transform:scaleX(1)}50%{transform:scaleX(.14)}}
.schema .bul{fill:#52FCC3;opacity:0}
.b1{animation:sg-bulle 4s ease-in infinite}
.b2{animation:sg-bulle 4s ease-in .9s infinite}
.b3{animation:sg-bulle 4s ease-in 1.8s infinite}
.b4{animation:sg-bulle 4s ease-in 2.7s infinite}
@keyframes sg-bulle{
  0%{transform:translateY(0) scale(.5);opacity:0}
  20%{opacity:.9}
  62%{opacity:0}
  100%{transform:translateY(-74px) scale(1);opacity:0}
}

/* ── la boucle des solvants ── */
.boucle{fill:none;stroke:#52FCC3;stroke-width:2.2;stroke-linecap:round;
  stroke-dasharray:9 13;animation:sg-defile 2.4s linear infinite}
@keyframes sg-defile{to{stroke-dashoffset:-44}}

/* ── les trois sorties ── */
.schema .fil{stroke:#6E7DB6;stroke-width:2;stroke-dasharray:6 8;
  animation:sg-defile 3.4s linear infinite}
.sorties .pastille{fill:rgba(4,4,64,.72);stroke:var(--mint);stroke-width:1.6}
.sorties .sym{font-family:var(--disp);font-size:19px;font-weight:500;fill:var(--mint);text-anchor:middle}
.sorties .sym.petit{font-size:16px}
.sorties .nom{font-family:var(--sans);font-size:15px;fill:#C6D0EE}
.so{opacity:.55}
.so1{animation:sg-allume 6s ease-in-out infinite}
.so2{animation:sg-allume 6s ease-in-out 1.2s infinite}
.so3{animation:sg-allume 6s ease-in-out 2.4s infinite}
@keyframes sg-allume{0%,58%,100%{opacity:.55}16%,40%{opacity:1}}

/* ── la colonne des étapes ──
   Quatre rangées de hauteur égale, contenu calé en haut : le numéro se
   trouve donc toujours au même endroit de sa rangée, et l'onde peut le
   rejoindre exactement. L'onde est descendue de la demi-hauteur du numéro. */
.etapes{position:relative;display:grid;grid-template-rows:repeat(4,1fr);
  --couloir:clamp(92px,9.8vw,148px); --onde:clamp(58px,6vw,92px);
  padding-left:var(--couloir)}
/* L'onde déborde volontairement du cadre, en haut comme en bas : la carte la
   coupe à ses propres bords. Le décalage vertical la fait croiser l'axe
   exactement à la hauteur des titres. */
.etapes .onde{position:absolute;left:0;top:15px;width:var(--onde);
  height:100%;overflow:visible}
.et{position:relative}
.et h3{color:#fff;margin:0 0 9px;position:relative}
.et h3 .pt{position:absolute;top:50%;margin-top:-9px;
  left:calc(var(--onde) * .5 - var(--couloir) - 9px);
  width:18px;height:18px;border-radius:50%;
  background:var(--ink-deep);border:2px solid var(--c)}
.et h3 .pt::after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--c)}

.et p{font-size:14.6px;line-height:1.58;color:var(--soft-dark);max-width:40ch;
  hyphens:auto;-webkit-hyphens:auto}

@media(max-width:900px){
  .schema{grid-template-columns:1fr;gap:clamp(26px,4vw,40px)}
  .etapes{grid-template-rows:none;gap:26px;padding-left:38px}
  .etapes .onde{display:none}
  .etapes::before{content:"";position:absolute;left:9px;top:12px;bottom:8px;width:2px;
    background:var(--grad);opacity:.55}
  .et h3 .pt{left:-38px;top:12px;margin-top:0}
  .et p{max-width:none}
  .schema .lbl{font-size:15px}
  .schema .sous{font-size:15px}
  .sorties .nom{font-size:17px}
  .sorties .sym{font-size:22px}
}
@media(prefers-reduced-motion:reduce){
  .schema *{animation:none !important}
  .so{opacity:1}
  .gros .gr,.copeaux .cp{opacity:1}
  .g1{transform:translate(104px,8px) rotate(-14deg)}
  .g2{transform:translate(168px,-6px) rotate(9deg)}
  .g3{transform:translate(212px,16px) rotate(20deg)}
  .c1{transform:translate(140px,176px)}  .c2{transform:translate(166px,204px)}
  .c3{transform:translate(148px,236px)}  .c4{transform:translate(172px,264px)}
  .schema .bul{opacity:.7}
}

.mesures{margin-top:clamp(30px,3.6vw,48px);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:clamp(22px,3vw,44px);border-top:1px solid var(--line);padding-top:clamp(24px,2.6vw,34px)}
@media(max-width:840px){.mesures{grid-template-columns:1fr;gap:26px}}
.mesures .q{font-size:12px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;
  color:var(--mint-d);margin-bottom:11px}
.mesures p{font-size:15.4px;line-height:1.6;color:var(--soft)}
/* Les trois résultats mesurés, présentés en encadrés sous les produits :
   même famille visuelle que les points clés de l'accueil. */
.mesures.cartes{border-top:0;padding-top:0;margin-top:clamp(26px,3vw,40px);gap:14px}
.mesures.cartes > div{border:1px solid var(--line);border-radius:14px;
  padding:20px 22px;background:rgba(255,255,255,.5)}
.mesures.cartes .q{color:var(--mint-d)}

.preuves{margin-top:clamp(28px,3.4vw,44px);display:grid;gap:0;
  border-top:1px solid var(--line-d)}
.preuves li{padding:clamp(17px,1.8vw,23px) 0;border-bottom:1px solid var(--line-d);
  display:grid;grid-template-columns:150px 1fr;gap:clamp(18px,2.6vw,40px);align-items:start}
@media(max-width:760px){.preuves li{grid-template-columns:1fr;gap:10px}
  .preuves .pv{grid-column:1}}
.preuves .q{font-size:12px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;
  color:var(--mint);padding-top:5px;grid-column:1;grid-row:1/-1}
/* Le titre, le texte et le lien s'empilent dans la seconde colonne, sous peine
   de se répartir en quinconce entre les deux. */
.preuves h3,.preuves p,.preuves .nlien,.preuves .pv{grid-column:2}
@media(max-width:760px){.preuves .q{grid-column:1;grid-row:auto}
  .preuves h3,.preuves p,.preuves .nlien{grid-column:1}}
.preuves h3{color:#fff;max-width:60ch}
.preuves p{margin-top:9px;font-size:15.4px;line-height:1.6;color:var(--soft-dark);
  max-width:none;hyphens:auto;-webkit-hyphens:auto;text-wrap:pretty}
.preuves .pv .nlien{margin-top:11px}
.preuves b{color:#fff;font-weight:600}
.preuves .nlien{display:inline-flex;align-items:center;gap:8px;margin-top:13px;font-size:14.6px;
  color:var(--mint);border-bottom:1px solid rgba(82,252,195,.4);padding-bottom:2px;transition:.2s}
.preuves .nlien:hover{color:#fff;border-color:#fff}
.preuves .nlien .a{transition:transform .2s}
.preuves .nlien:hover .a{transform:translateX(3px)}
</style>
