<script>
(function(){
  /* --- Menu repliable --- */
  var burger = document.getElementById('burger'), liens = document.getElementById('links');
  if (burger && liens) burger.addEventListener('click', function(){ liens.classList.toggle('open'); });

  /* --- Apparitions au défilement --- */
  (function(){
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('anim');
    var SEL = ['.hero .wrap > *','.phead .wrap > *','.eyebrow','.stmt','.fig','.row',
               '.flow','.st','.chip','.sc','.logos > div','.mem','.pc','.use','.sn',
               '.cgrid > div','.team','.legal > *','.scale','.na','.art > *'];
    var els = [];
    SEL.forEach(function(s){
      document.querySelectorAll(s).forEach(function(el){
        if (el.closest('header')) return;
        if (el.closest('[data-l]')) return;
        if (el.parentElement && el.parentElement.closest('.reveal')) return;
        if (els.indexOf(el) === -1) els.push(el);
      });
    });
    els.forEach(function(el){
      el.classList.add('reveal');
      var sib = Array.prototype.filter.call(el.parentElement.children, function(c){
        return c.classList.contains('reveal');
      });
      var i = sib.indexOf(el);
      el.style.setProperty('--i', i > 6 ? 6 : i);
    });
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    els.forEach(function(el){ io.observe(el); });
  })();

  /* --- Anciennes adresses ---
     Le site tenait autrefois en une seule page, où l'on changeait de rubrique
     par un dièse. Ces adresses ont pu être partagées : on les fait suivre. */
  (function(){
    var VERS = {{ adresses | dump | safe }};
    var ANCIEN = {'#procede':'technologie','#antimoine':'antimoine','#equipe':'equipe',
                  '#actualites':'actualites','#mentions':'mentions','#confidentialite':'confidentialite'};
    var cle = ANCIEN[location.hash];
    if (cle && VERS[cle]) location.replace(VERS[cle]['{{ langue }}']);
  })();

})();
</script>
