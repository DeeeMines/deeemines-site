<!-- ═══════════ Schéma animé du procédé ═══════════
     À gauche, la scène : les plastiques ignifugés arrivent en morceaux,
     passent au broyeur, tombent dans le réacteur agité où deux phases
     séparent la matière, et il en sort trois produits pendant que les
     solvants repartent en boucle fermée.
     À droite, la sinusoïde descend, ses points en regard des quatre étapes.
     Tout est en SVG et en CSS, sans bibliothèque ni fichier à charger.
     Les mouvements s'arrêtent pour qui a demandé à son système de les réduire. -->
<div class="schema">

  <!-- ───────────── la scène ───────────── -->
  <div class="scene" role="img"
       aria-label="Schéma animé : des plastiques ignifugés issus de déchets électroniques, de bâches et de câbles passent dans un broyeur, tombent dans un réacteur agité contenant deux phases liquides, et il en sort de l'antimoine, des composés bromés et du polymère purifié ; les solvants sont régénérés et repartent dans le réacteur.">
    <svg viewBox="0 0 560 664" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="sgOrg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#297EE1" stop-opacity=".62"/>
          <stop offset="1" stop-color="#2B2BE8" stop-opacity=".34"/>
        </linearGradient>
        <linearGradient id="sgAq" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3EBDD2" stop-opacity=".5"/>
          <stop offset="1" stop-color="#1793AB" stop-opacity=".74"/>
        </linearGradient>
        <clipPath id="sgCuve"><rect x="100" y="220" width="220" height="325" rx="28"/></clipPath>
        <marker id="sgFleche" viewBox="0 0 10 10" refX="9" refY="5"
                markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#52FCC3"/>
        </marker>
      </defs>

      <!-- ── ce qui entre ── -->
      <text class="lbl fort" x="286" y="40">Plastiques ignifugés</text>
      <text class="sous" x="286" y="62">déchets électroniques, bâches, câbles, etc.</text>
      <g class="gros">
        <rect class="gr g1" width="46" height="30" rx="5"/>
        <rect class="gr g2" width="34" height="38" rx="5"/>
        <rect class="gr g3" width="52" height="24" rx="5"/>
      </g>

      <!-- ── le broyeur ── -->
      <path class="carter" d="M102 80 L226 80 L226 128 L200 156 L128 156 L102 128 z"/>
      <g class="rouleau r1"><circle cx="141" cy="114" r="19"/>
        <g class="dents">
          <path d="M141 95 v-6"/><path d="M154 101 l4.5-4.5"/><path d="M160 114 h6"/><path d="M154 127 l4.5 4.5"/>
          <path d="M141 133 v6"/><path d="M128 127 l-4.5 4.5"/><path d="M122 114 h-6"/><path d="M128 101 l-4.5-4.5"/>
        </g>
      </g>
      <g class="rouleau r2"><circle cx="187" cy="114" r="19"/>
        <g class="dents">
          <path d="M187 95 v-6"/><path d="M200 101 l4.5-4.5"/><path d="M206 114 h6"/><path d="M200 127 l4.5 4.5"/>
          <path d="M187 133 v6"/><path d="M174 127 l-4.5 4.5"/><path d="M168 114 h-6"/><path d="M174 101 l-4.5-4.5"/>
        </g>
      </g>

      <!-- ── le réacteur ── -->
      <rect class="moteur" x="192" y="196" width="36" height="22" rx="5"/>
      <g clip-path="url(#sgCuve)">
        <rect x="100" y="220" width="220" height="325" fill="#080848"/>
        <path class="phase org" d="M -230 304 C -211.667 293.95, -193.333 293.95, -175 304 C -156.667 314.05, -138.333 314.05, -120 304 C -101.667 293.95, -83.3333 293.95, -65 304 C -46.6667 314.05, -28.3333 314.05, -10 304 C 8.33333 293.95, 26.6667 293.95, 45 304 C 63.3333 314.05, 81.6667 314.05, 100 304 C 118.333 293.95, 136.667 293.95, 155 304 C 173.333 314.05, 191.667 314.05, 210 304 C 228.333 293.95, 246.667 293.95, 265 304 C 283.333 314.05, 301.667 314.05, 320 304 C 338.333 293.95, 356.667 293.95, 375 304 C 393.333 314.05, 411.667 314.05, 430 304 C 448.333 293.95, 466.667 293.95, 485 304 C 503.333 314.05, 521.667 314.05, 540 304 L 540 600 L -230 600 Z"/>
        <path class="phase aq" d="M -300 392 C -276.667 383.29, -253.333 383.29, -230 392 C -206.667 400.71, -183.333 400.71, -160 392 C -136.667 383.29, -113.333 383.29, -90 392 C -66.6667 400.71, -43.3333 400.71, -20 392 C 3.33333 383.29, 26.6667 383.29, 50 392 C 73.3333 400.71, 96.6667 400.71, 120 392 C 143.333 383.29, 166.667 383.29, 190 392 C 213.333 400.71, 236.667 400.71, 260 392 C 283.333 383.29, 306.667 383.29, 330 392 C 353.333 400.71, 376.667 400.71, 400 392 C 423.333 383.29, 446.667 383.29, 470 392 C 493.333 400.71, 516.667 400.71, 540 392 L 540 600 L -300 600 Z"/>

        <!-- matière en suspension dans la phase organique -->
        <g class="grains org">
          <circle cx="134" cy="332" r="4"   style="animation-duration:9s"/>
          <circle cx="178" cy="356" r="2.6" style="animation-duration:11s;animation-delay:-3s"/>
          <circle cx="246" cy="326" r="5"   style="animation-duration:8s;animation-delay:-5s"/>
          <circle cx="282" cy="364" r="3.2" style="animation-duration:12s;animation-delay:-1.5s"/>
          <circle cx="160" cy="374" r="2.2" style="animation-duration:10s;animation-delay:-6s"/>
          <circle cx="300" cy="336" r="3.8" style="animation-duration:9.5s;animation-delay:-4s"/>
        </g>
        <!-- antimoine capté dans la phase aqueuse -->
        <g class="grains aq">
          <circle cx="140" cy="428" r="3.4" style="animation-duration:10s;animation-delay:-2s"/>
          <circle cx="192" cy="466" r="5"   style="animation-duration:8.5s;animation-delay:-6s"/>
          <circle cx="256" cy="436" r="2.6" style="animation-duration:12s;animation-delay:-3.5s"/>
          <circle cx="296" cy="492" r="4.2" style="animation-duration:9s;animation-delay:-7s"/>
          <circle cx="150" cy="508" r="2.4" style="animation-duration:11s;animation-delay:-1s"/>
          <circle cx="232" cy="518" r="3.6" style="animation-duration:9.8s;animation-delay:-4.5s"/>
        </g>

        <circle class="bul b1" cx="176" cy="470" r="4"/>
        <circle class="bul b2" cx="212" cy="480" r="3"/>
        <circle class="bul b3" cx="252" cy="466" r="5"/>
        <circle class="bul b4" cx="284" cy="478" r="3.2"/>

        <!-- l'agitateur -->
        <line class="arbre" x1="210" y1="218" x2="210" y2="492"/>
        <g class="pale">
          <rect x="160" y="482" width="100" height="10" rx="5"/>
          <rect x="163" y="488" width="10" height="24" rx="5"/>
          <rect x="247" y="488" width="10" height="24" rx="5"/>
        </g>
      </g>

      <!-- les copeaux tombent jusqu'à la surface du liquide, où ils disparaissent.
           Dessinés après la cuve pour rester visibles au-dessus du bain. -->
      <g class="copeaux">
        <rect class="cp c1" width="15" height="9"  rx="2"/>
        <rect class="cp c2" width="11" height="11" rx="2"/>
        <rect class="cp c3" width="17" height="8"  rx="2"/>
        <rect class="cp c4" width="10" height="12" rx="2"/>
      </g>
      <rect class="cuve" x="100" y="220" width="220" height="325" rx="28"/>

      <!-- ── la boucle des solvants ── -->
      <path class="boucle" marker-end="url(#sgFleche)"
            d="M300 538 L300 592 Q300 602 290 602 L140 602 Q130 602 130 592 L130 542"/>
      <text class="lbl mint" x="215" y="638">Solvants régénérés, en boucle fermée</text>

      <!-- ── les trois sorties, prises dans les phases ── -->
      <g class="sorties">
        <g class="so so1">
          <line class="fil" x1="326" y1="352" x2="372" y2="352"/>
          <rect class="pastille" x="372" y="331" width="42" height="42" rx="11"/>
          <text class="sym" x="393" y="359">Sb</text>
          <text class="nom" x="424" y="358">Antimoine</text>
        </g>
        <g class="so so2">
          <line class="fil" x1="326" y1="428" x2="372" y2="428"/>
          <rect class="pastille" x="372" y="407" width="42" height="42" rx="11"/>
          <text class="sym" x="393" y="435">Br</text>
          <text class="nom" x="424" y="434">Composés bromés</text>
        </g>
        <g class="so so3">
          <line class="fil" x1="326" y1="504" x2="372" y2="504"/>
          <rect class="pastille" x="372" y="483" width="42" height="42" rx="11"/>
          <text class="sym petit" x="393" y="511">Cn</text>
          <text class="nom" x="424" y="510">Polymère purifié</text>
        </g>
      </g>
    </svg>
  </div>

  <!-- ───────────── la sinusoïde et les quatre étapes ───────────── -->
  <div class="etapes">
    <svg class="onde" viewBox="0 0 100 800" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="sgOnde" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2B2BE8"/><stop offset=".25" stop-color="#297EE1"/>
          <stop offset=".5" stop-color="#3EBDD2"/><stop offset=".75" stop-color="#52FCC3"/>
          <stop offset="1" stop-color="#52FCC3"/>
        </linearGradient>
      </defs>
      <!-- L'onde traverse le cadre de part en part : elle se prolonge au-delà
           du dernier point, au lieu de s'y éteindre. Elle croise l'axe à
           0, 200, 400 et 600, exactement là où se posent les quatre points. -->
      <path d="M50 -140 C 4 -80, 4 0, 50 0 C 96 60, 96 140, 50 200
               C 4 260, 4 340, 50 400 C 96 460, 96 540, 50 600
               C 4 660, 4 740, 50 800 C 96 860, 96 940, 50 1000"
            stroke="url(#sgOnde)" stroke-width="2" vector-effect="non-scaling-stroke"
            stroke-linecap="round"/>
    </svg>

    <div class="et" style="--c:var(--blue)">
      <h3><span class="pt"></span>Broyage</h3>
      <div data-l="fr"><p>Le gisement arrive en pièces de toutes tailles. Le broyage donne une
        fraction homogène, condition d'un rendement stable.</p></div>
      <div data-l="en" hidden><p>The waste arrives in pieces of every size. Shredding gives an
        even fraction, the condition for a stable yield.</p></div>
    </div>
    <div class="et" style="--c:var(--azure)">
      <h3><span class="pt"></span>Solvatation</h3>
      <div data-l="fr"><p>Le solvant organique met le polymère en solution. Les additifs,
        jusque-là prisonniers de la matrice, deviennent accessibles.</p></div>
      <div data-l="en" hidden><p>The organic solvent dissolves the polymer. The additives,
        until then trapped in the matrix, become reachable.</p></div>
    </div>
    <div class="et" style="--c:var(--cyan)">
      <h3><span class="pt"></span>Extraction sélective</h3>
      <div data-l="fr"><p>La solution aqueuse complexante capte l'oxyde d'antimoine. Le
        tétrabromobisphénol A est extrait ensuite, au non-solvant.</p></div>
      <div data-l="en" hidden><p>The complexing water solution captures the antimony oxide.
        Tetrabromobisphenol A is then extracted with a non-solvent.</p></div>
    </div>
    <div class="et" style="--c:var(--mint)">
      <h3><span class="pt"></span>Insolubilisation</h3>
      <div data-l="fr"><p>Le polymère dépollué est reprécipité, récupéré solide et séché. Les
        solvants régénérés repartent dans le cycle suivant.</p></div>
      <div data-l="en" hidden><p>The cleaned polymer is precipitated out, recovered solid and
        dried. The regenerated solvents go into the next cycle.</p></div>
    </div>
  </div>
</div>
