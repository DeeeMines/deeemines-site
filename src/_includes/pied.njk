<footer>
  <div class="wrap">
    <div class="fg">
      <div class="fm">
        <a class="marque" href="{{ adresses['accueil'][langue] }}"><img class="symbole" src="/assets/symbole.png" alt="" aria-hidden="true"><img src="/assets/logo.png" alt="DeeeMines"></a>
        <p class="bl" data-champ="communs.divers.signature">{{ t.communs.divers.signature }}</p>
      </div>
      <div class="fl">
        <a href="{{ adresses['accueil'][langue] }}" data-champ="communs.nav.accueil">{{ t.communs.nav.accueil }}</a>
        {%- for cle in ["technologie", "antimoine", "equipe", "actualites"] %}
        <a href="{{ adresses[cle][langue] }}" data-champ="communs.nav.{{ cle }}">{{ t.communs.nav[cle] }}</a>
        {%- endfor %}
        <a href="{{ adresses['accueil'][langue] }}#contact" data-champ="communs.nav.contact">{{ t.communs.nav.contact }}</a>
        <a href="{{ t.communs.contact.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
    <div class="fb">
      <span data-champ="communs.nav.droits">{{ t.communs.nav.droits }}</span>
      <span><a href="{{ adresses['mentions'][langue] }}" data-champ="communs.nav.mentions">{{ t.communs.nav.mentions }}</a>
        · <a href="{{ adresses['confidentialite'][langue] }}" data-champ="communs.nav.confidentialite">{{ t.communs.nav.confidentialite }}</a></span>
    </div>
  </div>
</footer>
