<!DOCTYPE html>
<html lang="{{ langue }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- Le titre et la description viennent de src/_data/meta.json, par page et par
    langue. L'adresse canonique et les liens « alternate » disent au moteur de
    recherche quelle page est la référence et où trouver l'autre langue. -#}
{%- set m = meta[langue][page_cle] if page_cle else false %}
{%- set titre_page = titre or (m.titre if m else "DeeeMines") %}
{%- set desc_page = description or (m.description if m else "") %}
<title>{{ titre_page }}</title>
<meta name="description" content="{{ desc_page }}">
<meta name="robots" content="noindex, nofollow">
<link rel="canonical" href="{{ reglages.domaine }}{{ adresse_fr if langue == 'fr' else adresse_en }}">
<link rel="alternate" hreflang="fr" href="{{ reglages.domaine }}{{ adresse_fr }}">
<link rel="alternate" hreflang="en" href="{{ reglages.domaine }}{{ adresse_en }}">
<link rel="alternate" hreflang="x-default" href="{{ reglages.domaine }}{{ adresse_fr }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%232B2BE8'/%3E%3Cstop offset='.55' stop-color='%23297EE1'/%3E%3Cstop offset='1' stop-color='%2352FCC3'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='%23040440'/%3E%3Ctext x='32' y='45' font-family='Helvetica,Arial,sans-serif' font-size='34' font-weight='600' text-anchor='middle' fill='url(%23g)'%3ED%3C/text%3E%3C/svg%3E">
<meta property="og:type" content="website">
<meta property="og:site_name" content="DeeeMines">
<meta property="og:locale" content="{{ 'fr_FR' if langue == 'fr' else 'en_GB' }}">
<meta property="og:title" content="{{ ogTitre or titre_page }}">
<meta property="og:description" content="{{ desc_page }}">
<meta property="og:url" content="{{ reglages.domaine }}{{ adresse_fr if langue == 'fr' else adresse_en }}">
<meta property="og:image" content="{{ reglages.domaine }}{{ ogImage or '/og.jpg' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
{% include "styles.njk" %}
</head>
