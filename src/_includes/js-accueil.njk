<script>
(function(){
  var ANCRES={'#antimoine':'antimoine','#equipe':'equipe','#actualites':'actus',
              '#procede':'procede','#mentions':'mentions','#confidentialite':'privacy'};
  var current='home';
  var PAGES={home:'page-home',equipe:'page-equipe',antimoine:'page-antimoine',procede:'page-procede',actus:'page-actus',mentions:'page-mentions',privacy:'page-privacy'};
  function show(key,hash){
    for(var k in PAGES){document.getElementById(PAGES[k]).classList.toggle('active',k===key);}
    document.querySelectorAll('.links a').forEach(function(a){
      var g=a.getAttribute('data-go');
      a.classList.toggle('on', g===key && g!=='home');
      a.blur();
    });
    current=key;
    document.getElementById('links').classList.remove('open');
    if(hash){var el=document.querySelector(hash);
      if(el){setTimeout(function(){el.scrollIntoView({behavior:'smooth',block:'start'});},40);return;}}
    window.scrollTo({top:0,behavior:'smooth'});
  }
  document.addEventListener('click',function(e){
    var a=e.target.closest('[data-go]'); if(!a) return;
    e.preventDefault();
    var href=a.getAttribute('href')||'', i=href.indexOf('#');
    var ancre=(i>=0 && href.length>i+1) ? href.slice(i) : null;
    if (ancre==='#top' || ANCRES[ancre]) ancre=null;
    show(a.getAttribute('data-go'), ancre);
  });

  /* --- Arrivée depuis une page d'actualité --- */
  if (ANCRES[location.hash]) {
    var depart=ANCRES[location.hash];
    for (var p in PAGES){document.getElementById(PAGES[p]).classList.toggle('active',p===depart);}
    document.querySelectorAll('.links a').forEach(function(a){
      a.classList.toggle('on', a.getAttribute('data-go')===depart);
    });
    current=depart;
  }

  /* --- Repérage de la section visible sur la page d'accueil --- */
  var spy = ['solution','technologie'];
  var obs = new IntersectionObserver(function(entries){
    if (current !== 'home') return;
    entries.forEach(function(e){
      var l = document.querySelector('.links a[href="#'+e.target.id+'"]');
      if (l) l.classList.toggle('on', e.isIntersecting);
    });
  }, { rootMargin:'-45% 0px -45% 0px' });
  spy.forEach(function(id){ var el=document.getElementById(id); if(el) obs.observe(el); });


  /* --- Vidéo : le lecteur extérieur n'est chargé qu'au clic --- */
  var ap = document.querySelector('.cadre.apercu');
  if (ap) ap.addEventListener('click', function(){
    var u = ap.getAttribute('data-video'); if (!u) return;
    ap.innerHTML = '<iframe src="' + u + (u.indexOf('?') < 0 ? '?' : '&') +
      'autoplay=1" title="Présentation de la thèse de Morvan Gaudin" allowfullscreen ' +
      'allow="autoplay; encrypted-media; picture-in-picture; fullscreen"></iframe>';
    ap.classList.remove('apercu');
  });

  /* --- Formulaire de contact --- */
  var form=document.getElementById('cform'), sent=document.getElementById('sent'),
      cerr=document.getElementById('cerr'), envoi=form.querySelector('button[type=submit]');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var v=function(id){return (document.getElementById(id)||{}).value||'';};
    var corps='Nom : '+v('a1')+'\nE-mail : '+v('a2')+'\nProfil : '+v('a3')+'\n\n'+v('a4');
    document.getElementById('mailto').href='mailto:kristell.riounivert@deeemines.com'
      +'?subject='+encodeURIComponent('Contact site DeeeMines')+'&body='+encodeURIComponent(corps);
    cerr.hidden=true; envoi.disabled=true;
    /* Sans clé renseignée, on n'essaie même pas : on propose le courriel. */
    var cle=(form.querySelector('[name=access_key]')||{}).value||'';
    if(!cle){ cerr.hidden=false; envoi.disabled=false; return; }
    fetch('https://api.web3forms.com/submit',{method:'POST',
               headers:{'Content-Type':'application/json','Accept':'application/json'},
               body:JSON.stringify(Object.fromEntries(new FormData(form)))})
      .then(function(r){
        if(!r.ok) throw new Error(r.status);
        form.hidden=true; sent.hidden=false;
        sent.scrollIntoView({behavior:'smooth',block:'center'});
      })
      .catch(function(){ envoi.disabled=false; cerr.hidden=false; });
  });
})();
</script>
