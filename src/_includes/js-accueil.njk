<script>
(function(){
  /* --- Repérage de la section visible sur la page d'accueil --- */


  /* --- Vidéo : le lecteur extérieur n'est chargé qu'au clic --- */
  var ap = document.querySelector('.cadre.apercu');
  if (ap) ap.addEventListener('click', function(){
    var u = ap.getAttribute('data-video'); if (!u) return;
    ap.innerHTML = '<iframe src="' + u + (u.indexOf('?') < 0 ? '?' : '&') +
      'autoplay=1" title="{{ t.communs.alt.video_titre }}" allowfullscreen ' +
      'allow="autoplay; encrypted-media; picture-in-picture; fullscreen"></iframe>';
    ap.classList.remove('apercu');
  });

  /* --- Formulaire de contact, présent sur la seule page d'accueil --- */
  var form=document.getElementById('cform'), sent=document.getElementById('sent'),
      cerr=document.getElementById('cerr');
  if (!form) return;
  var envoi=form.querySelector('button[type=submit]');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var v=function(id){return (document.getElementById(id)||{}).value||'';};
    var en=document.documentElement.lang==='en';
    var corps=(en?'Name: ':'Nom : ')+v('a1')
             +(en?'\nEmail: ':'\nE-mail : ')+v('a2')
             +(en?'\nProfile: ':'\nProfil : ')+v('a3')+'\n\n'+v('a4');
    document.getElementById('mailto').href='mailto:{{ t.communs.contact.email }}'
      +'?subject='+encodeURIComponent(en?'Enquiry from the DeeeMines website':'Contact site DeeeMines')
      +'&body='+encodeURIComponent(corps);
    cerr.hidden=true; envoi.disabled=true;
    /* Sans clé renseignée, on n'essaie même pas : on propose le courriel. */
    var cle=(form.querySelector('[name=access_key]')||{}).value||'';
    if(!cle){ cerr.hidden=false; envoi.disabled=false; return; }
    fetch('https://api.web3forms.com/submit',{method:'POST',
               headers:{'Content-Type':'application/json','Accept':'application/json'},
               body:JSON.stringify(Object.fromEntries(new FormData(form)))})
      .then(function(r){
        if(!r.ok) throw new Error(r.status);
        form.hidden=true; sent.hidden=false;
        sent.scrollIntoView({behavior:'smooth',block:'center'});
      })
      .catch(function(){ envoi.disabled=false; cerr.hidden=false; });
  });
})();
</script>
