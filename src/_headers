# En-têtes HTTP, lus par Cloudflare Pages dans le site publié.
# Remplace ce que netlify.toml faisait auparavant.

/admin/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache, max-age=0, must-revalidate

# L'archive de l'ancien site : consultable par qui connaît l'adresse, jamais
# indexée, pour qu'elle ne concurrence pas les pages du site dans les moteurs
# de recherche.
/old/*
  X-Robots-Tag: noindex
