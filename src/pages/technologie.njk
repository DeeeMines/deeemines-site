<!-- ===================== LE PROCÉDÉ =====================
     Page profonde, atteinte depuis le bandeau du haut et depuis le bouton
     de la section technologie de l'accueil.

     Les paragraphes explicatifs sont écrits en deux versions complètes,
     français et anglais, dans des blocs « data-l ». C'est ce qui permet d'y
     mettre des mots en gras : le dictionnaire de traduction travaille sur des
     textes entiers, et un mot en gras couperait le texte en morceaux qu'il ne
     saurait plus reconnaître.
     Le lien de la vidéo se saisit depuis /admin, rubrique « Page d'accueil ». -->
<main>
  <div class="phead">
    <div class="wrap">
      <h1 data-champ="procede.phead.titre">{{ t.procede.phead.titre | safe }}</h1>
      <p class="lead" data-champ="procede.phead.chapo">{{ t.procede.phead.chapo | safe }}</p>
    </div>
  </div>
  <hr class="grad-rule">

  {%- set video = t.procede.video.lien | default("") %}
  <section>
    <div class="wrap">
      <div class="eyebrow" data-champ="procede.en_quatre_minutes.surtitre">{{ t.procede.en_quatre_minutes.surtitre | safe }}</div>
      <div class="video">
        {%- set embed = video | lecteur %}
        {%- if embed %}
        <div class="cadre apercu" data-video="{{ embed }}">
          <img src="/assets/video-these.jpg" alt="{{ t.communs.alt.video }}">
          <button class="jouer" type="button" aria-label="{{ t.communs.alt.jouer }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <circle cx="12" cy="12" r="10.4"/><path d="M9.8 8.2l6.4 3.8-6.4 3.8z" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        {%- elif video %}
        <div class="cadre vide">
          <a class="btn btn-ink" href="{{ video }}" target="_blank" rel="noopener">
            {{ t.communs.divers.voir_video }} <span class="a">&#8594;</span></a>
        </div>
        {%- else %}
        <div class="cadre vide">
          <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.3" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M10 8.6l6 3.4-6 3.4z" stroke-linejoin="round"/>
          </svg>
          <p data-champ="procede.en_quatre_minutes.texte">{{ t.procede.en_quatre_minutes.texte | safe }}</p>
        </div>
        {%- endif %}
        <div class="lead vlegende">
          <div data-l="fr" data-champ="procede.en_quatre_minutes.bloc">{{ t.procede.en_quatre_minutes.bloc | safe }}</div>
        </div>
      </div>
    </div>
  </section>

