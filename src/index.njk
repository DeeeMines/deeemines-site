<script>
(function(){
  var current='home';
  var PAGES={home:'page-home',equipe:'page-equipe',antimoine:'page-antimoine',actus:'page-actus',mentions:'page-mentions',privacy:'page-privacy'};
  function show(key,hash){
    for(var k in PAGES){document.getElementById(PAGES[k]).classList.toggle('active',k===key);}
    document.querySelectorAll('.links a').forEach(function(a){
      var g=a.getAttribute('data-go');
      a.classList.toggle('on', g===key && g!=='home');
      a.blur();
    });
    current=key;
    document.getElementById('links').classList.remove('open');
    if(hash){var el=document.querySelector(hash);
      if(el){setTimeout(function(){el.scrollIntoView({behavior:'smooth',block:'start'});},40);return;}}
    window.scrollTo({top:0,behavior:'smooth'});
  }
  document.addEventListener('click',function(e){
    var a=e.target.closest('[data-go]'); if(!a) return;
    e.preventDefault();
    var href=a.getAttribute('href')||'';
    show(a.getAttribute('data-go'),(href.indexOf('#')===0&&href.length>1&&href!=='#top')?href:null);
  });
  document.getElementById('burger').addEventListener('click',function(){
    document.getElementById('links').classList.toggle('open');
  });

  /* --- Apparitions au défilement --- */
  (function(){
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('anim');
    var SEL = ['.hero .wrap > *','.phead .wrap > *','.eyebrow','.stmt','.fig','.row',
               '.flow','.st','.chip','.sc','.logos > div','.mem','.pc','.use','.sn',
               '.cgrid > div','.team','.legal > *','.scale','.na'];
    var els = [];
    SEL.forEach(function(s){
      document.querySelectorAll(s).forEach(function(el){
        if (el.closest('header')) return;
        if (el.parentElement && el.parentElement.closest('.reveal')) return;
        if (els.indexOf(el) === -1) els.push(el);
      });
    });
    els.forEach(function(el){
      el.classList.add('reveal');
      var sib = Array.prototype.filter.call(el.parentElement.children, function(c){
        return c.classList.contains('reveal');
      });
      var i = sib.indexOf(el);
      el.style.setProperty('--i', i > 6 ? 6 : i);
    });
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    els.forEach(function(el){ io.observe(el); });
  })();

  /* --- Repérage de la section visible sur la page d'accueil --- */
  var spy = ['solution','technologie'];
  var obs = new IntersectionObserver(function(entries){
    if (current !== 'home') return;
    entries.forEach(function(e){
      var l = document.querySelector('.links a[href="#'+e.target.id+'"]');
      if (l) l.classList.toggle('on', e.isIntersecting);
    });
  }, { rootMargin:'-45% 0px -45% 0px' });
  spy.forEach(function(id){ var el=document.getElementById(id); if(el) obs.observe(el); });


  /* --- Bascule français / anglais --- */
  var I18N = {{ i18n | dump | safe }};
  var ATTRS = {"Votre nom": "Your name", "vous@organisation.fr": "you@organisation.com", "Quelques lignes suffisent.": "A few lines are enough."};
  var TITLE_EN = "DeeeMines · Europe imports all of its antimony. We produce it here.", TITLE_FR = document.title;
  var nodes = [];
  (function walk(el){
    for (var i=0;i<el.childNodes.length;i++){
      var n = el.childNodes[i];
      if (n.nodeType === 3){
        var m = n.nodeValue.match(/^(\s*)([\s\S]*?)(\s*)$/);
        var key = m[2].replace(/\s+/g,' ');
        if (key && I18N[key]) nodes.push([n, n.nodeValue, m[1] + I18N[key] + m[3]]);
      } else if (n.nodeType === 1 && n.tagName !== 'SCRIPT' && n.tagName !== 'STYLE'){
        walk(n);
      }
    }
  })(document.body);
  var fields = [];
  document.querySelectorAll('[placeholder]').forEach(function(el){
    var p = el.getAttribute('placeholder');
    if (ATTRS[p]) fields.push([el, p, ATTRS[p]]);
  });
  function setLang(l){
    var k = (l === 'en') ? 2 : 1;
    nodes.forEach(function(t){ t[0].nodeValue = t[k]; });
    fields.forEach(function(f){ f[0].setAttribute('placeholder', f[k]); });
    document.documentElement.lang = l;
    document.title = (l === 'en') ? TITLE_EN : TITLE_FR;
    document.querySelectorAll('.lang b').forEach(function(b){
      b.classList.toggle('on', b.getAttribute('data-lang') === l);
    });
  }
  document.querySelectorAll('.lang b').forEach(function(b){
    b.addEventListener('click', function(){ setLang(b.getAttribute('data-lang')); });
  });

  /* --- Formulaire de contact --- */
  var form=document.getElementById('cform'), sent=document.getElementById('sent'),
      cerr=document.getElementById('cerr'), envoi=form.querySelector('button[type=submit]');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var v=function(id){return (document.getElementById(id)||{}).value||'';};
    var corps='Nom : '+v('a1')+'\nE-mail : '+v('a2')+'\nProfil : '+v('a3')+'\n\n'+v('a4');
    document.getElementById('mailto').href='mailto:contact@deeemines.com'
      +'?subject='+encodeURIComponent('Contact site DeeeMines')+'&body='+encodeURIComponent(corps);
    cerr.hidden=true; envoi.disabled=true;
    fetch('/',{method:'POST',
               headers:{'Content-Type':'application/x-www-form-urlencoded'},
               body:new URLSearchParams(new FormData(form)).toString()})
      .then(function(r){
        if(!r.ok) throw new Error(r.status);
        form.hidden=true; sent.hidden=false;
        sent.scrollIntoView({behavior:'smooth',block:'center'});
      })
      .catch(function(){ envoi.disabled=false; cerr.hidden=false; });
  });
})();
</script>
</body>
</html>
