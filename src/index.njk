        </div>
        <div class="bul" style="--c:var(--cyan-d)">
          <div class="rond"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 46c0-12 10-12 10-22a8 8 0 0 1 16 0c0 12 12 10 12 22"/><rect x="40" y="44" width="16" height="10" rx="3"/><path d="M44 44v-4M52 44v-4"/></svg></div>
