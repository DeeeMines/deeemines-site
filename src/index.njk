<main class="page" id="page-actus">
  <div class="phead">
    <div class="wrap">
      <div class="eyebrow" style="color:var(--mint)">Actualités</div>
      <h1>Ce qui avance chez DeeeMines.</h1>
      <p class="lead">Les étapes franchies, les soutiens obtenus et les partenariats signés, au fil de la montée en échelle du procédé.</p>
    </div>
  </div>
  <hr class="grad-rule">

  <section>
    <div class="wrap">
      <div class="news">
        {%- set ct = ["var(--mint-d)","var(--cyan-d)","var(--azure)"] %}
        {%- for a in actualites.fr.articles %}
        <article class="na" style="--ct:{{ ct[loop.index0 % 3] }}">
          <div class="when">{{ a.date }}</div>
          <div class="nc">
            <div>
              <div class="cat">{{ a.categorie }}</div>
              <h3>{{ a.titre }}</h3>
              <p>{{ a.resume }}</p>
              {%- if a.corps %}
              <a class="nlien" href="/actualites/{{ a.slug or (a.titre | adresse) }}/">Lire la suite <span class="a">&#8594;</span></a>
              {%- elif a.lien %}
              <a class="nlien" href="{{ a.lien }}" target="_blank" rel="noopener">{{ a.lien_texte or "En savoir plus" }} <span class="a">&#8594;</span></a>
              {%- endif %}
            </div>
          </div>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section class="dark" style="padding:clamp(42px,4.4vw,64px) 0;text-align:center">
    <div class="wrap">
      <h2 style="font-size:clamp(26px,3.4vw,40px)">Vous voulez suivre la suite ?</h2>
      <div style="margin-top:26px">
        <a href="#contact" data-go="home" class="btn btn-mint">Écrivez-nous <span class="a">&#8594;</span></a>
      </div>
    </div>
  </section>
